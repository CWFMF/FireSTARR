FROM registrycwfisdev.azurecr.io/firestarr/firestarr-app:0.9.5.5 AS firestarr-app-hotfix
ARG VERSION
ENV VERSION=${VERSION}
WORKDIR /appl/firestarr
COPY ./src/py/firestarr/ /appl/firestarr/src/py/firestarr/
COPY ./src/py/cffdrs-ng/NG_FWI.py /appl/firestarr/src/py/cffdrs-ng/
COPY ./src/py/cffdrs-ng/old_cffdrs.py /appl/firestarr/src/py/cffdrs-ng/
COPY ./src/py/cffdrs-ng/util.py /appl/firestarr/src/py/cffdrs-ng/
COPY --chown=user:user --from=ghcr.io/cwfmf/firestarr-cpp/firestarr:unstable-latest /appl/firestarr/* /appl/firestarr/
RUN sed -i "s/RASTER_ROOT = .*/RASTER_ROOT = ..\/data\/generated\/grid\/100m/" /appl/firestarr/settings.ini
RUN sed -i "s/MAXIMUM_TIME = .*/MAXIMUM_TIME = 36000/" /appl/firestarr/settings.ini
RUN sed -i "s/INTERIM_OUTPUT_INTERVAL = .*/INTERIM_OUTPUT_INTERVAL = 300/" /appl/firestarr/settings.ini
RUN echo "v0.9.6 is a patch of v0.9.5.5 to fix errors with empty dataframes but not upgrade numpy or anything else" > /appl/firestarr/NOTE.md
RUN echo "v0.9.7 adds ON specific datasources back" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.8 change SourceFireCiffc to use CWFIF WFS" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.9 changed EX status to OUT so old code works on it" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.10 remove --no-retry from options" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.11 burn any touched pixel into raster" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.12 queue recovery message" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.13 ensure submodule init to proper version on build container" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.14 fix ffmc bounds/rounding issue in cffdrs code" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.15 add GROUP_DISTANCE_KM config option" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.16 parallelize weather retrieval more" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.17 copy correct firestarr binary into container" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.18 use full zone_easting_northing of centroid for group names" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.19 pass --no-intensity and --tz to sim" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.20 fix check for number of fires with results that was previously looking for completely finished fires" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.21 modify defaults for settings.ini" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.22 reduce gribwx duration to 370 to hopefully avoid errors when members=all with no data at end" >> /appl/firestarr/NOTE.md
RUN echo "v0.9.23 better handle cwfis_fwi file for today being missing" >> /appl/firestarr/NOTE.md
RUN echo "v1.0.0 upload to firestarr groups layer in geoserver" >> /appl/firestarr/NOTE.md
RUN echo "v1.0.1 fix missing proj.db in container" >> /appl/firestarr/NOTE.md
RUN echo "v1.0.2 fix uploading groups gpkg to wrong location" >> /appl/firestarr/NOTE.md
RUN echo "v1.0.3 fix groups columns changing breaking layer" >> /appl/firestarr/NOTE.md
RUN echo "v1.0.4 make scripts/archive_sims.sh take optional argument for run to archive" >> /appl/firestarr/NOTE.md
